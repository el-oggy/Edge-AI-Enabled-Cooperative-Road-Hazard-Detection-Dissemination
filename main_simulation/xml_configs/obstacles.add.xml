<additional>
    <!-- 1. The Pothole (Stationary Dummy Vehicle) -->
    <!-- Route for the pothole so SUMO knows where it is -->
    <route id="pothole_route" edges="-1075652400" />
    
    <!-- We place it on the multi-lane edge at position 100 -->
    <vehicle id="pothole_1" type="pothole_dummy" depart="0.0" departPos="100" departLane="best" departSpeed="0" route="pothole_route">
        <stop lane="-1075652400_0" endPos="105" duration="3600"/>
    </vehicle>

    <route id="pothole_route_2" edges="-1075016000" />
    <vehicle id="pothole_2" type="pothole_dummy" depart="0.0" departPos="200" departLane="best" departSpeed="0" route="pothole_route_2">
        <stop lane="-1075016000_0" endPos="205" duration="3600"/>
    </vehicle>
    
    <route id="pothole_route_3" edges="-1074802263" />
    <vehicle id="pothole_3" type="pothole_dummy" depart="0.0" departPos="100" departLane="best" departSpeed="0" route="pothole_route_3">
        <stop lane="-1074802263_0" endPos="105" duration="3600"/>
    </vehicle>

    <!-- 2. The Slow Truck -->
    <route id="slow_route" edges="-1075652400" />
    <vehicle id="slow_truck" type="truck" depart="5.0" departPos="20" departLane="best" departSpeed="5" route="slow_route" />

    <!-- 3. The Broken Down Vehicle (Accident Scene) -->
    <route id="broken_route" edges="-1075652400" />
    <vehicle id="broken_car1" type="broken_down_car" depart="0.0" departPos="300" departLane="best" departSpeed="0" route="broken_route">
        <stop lane="-1075652400_0" endPos="305" duration="3600" parking="false"/>
    </vehicle>
    <vehicle id="broken_car2" type="broken_down_car" depart="0.0" departPos="305" departLane="best" departSpeed="0" route="broken_route">
        <stop lane="-1075652400_0" endPos="310" duration="3600" parking="false"/>
    </vehicle>

    <!-- 4. Construction Zone (Visual Cones & Lane Closure) -->
    <!-- Place a rerouter to close lane 0 from pos 400 to 500 -->
    <rerouter id="construction_closure" edges="-1075652400">
        <interval begin="0" end="3600">
            <closingLaneReroute id="-1075652400_0"/>
        </interval>
    </rerouter>

    <!-- Visual Traffic Cones for Construction (Native Orange Polygons) -->
    <!-- In SUMO, POIs without an image are drawn as simple circles. We make them orange. -->
    <poi id="cone1" type="construction" color="255,140,0" width="3" height="3" lane="-1075652400_0" pos="400"/>
    <poi id="cone2" type="construction" color="255,140,0" width="3" height="3" lane="-1075652400_0" pos="425"/>
    <poi id="cone3" type="construction" color="255,140,0" width="3" height="3" lane="-1075652400_0" pos="450"/>
    <poi id="cone4" type="construction" color="255,140,0" width="3" height="3" lane="-1075652400_0" pos="475"/>

    <poi id="cone5" type="construction" color="255,140,0" width="3" height="3" lane="-1055380174#1_0" pos="50"/>
    <poi id="cone6" type="construction" color="255,140,0" width="3" height="3" lane="-1055380174#1_0" pos="100"/>

    <poi id="cone7" type="construction" color="255,140,0" width="3" height="3" lane="-1075016000_0" pos="50"/>
    <poi id="cone8" type="construction" color="255,140,0" width="3" height="3" lane="-1075016000_0" pos="100"/>
    <poi id="cone9" type="construction" color="255,140,0" width="3" height="3" lane="-1075016000_0" pos="150"/>

</additional>
