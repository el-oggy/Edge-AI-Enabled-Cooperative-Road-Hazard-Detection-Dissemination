<?xml version="1.0" encoding="UTF-8"?>
<routes xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="http://sumo.dlr.de/xsd/routes_file.xsd">

    <!-- ================================================================ -->
    <!--  VEHICLE TYPES                                                   -->
    <!-- ================================================================ -->

    <!-- Connected Vehicle (Subject of V2X Alerts & RSU Communication) -->
    <vType id="car_connected" accel="2.6" decel="4.5" sigma="0.2" length="4.8"
           minGap="2.5" maxSpeed="13.89" color="60,140,255"
           lcStrategic="1.0" lcCooperative="1.0" lcSpeedGain="0.8"/>

    <!-- Ambient Urban Traffic (Background cars) -->
    <vType id="car_ambient" accel="2.2" decel="4.0" sigma="0.5" length="4.5"
           minGap="2.5" maxSpeed="13.89" color="200,200,200"
           lcStrategic="0.8" lcCooperative="0.6"/>

    <!-- City Transit Bus -->
    <vType id="bus" accel="1.2" decel="3.5" sigma="0.3" length="12.0"
           minGap="3.0" maxSpeed="11.11" color="30,60,130"
           guiShape="bus"/>

    <!-- Commercial Delivery Truck -->
    <vType id="truck" accel="1.5" decel="3.8" sigma="0.4" length="8.5"
           minGap="3.5" maxSpeed="11.11" color="90,90,110"
           guiShape="truck"/>

    <!-- ================================================================ -->
    <!--  INTERCONNECTED ARTERIAL ROUTES & CIRCUITS                       -->
    <!-- ================================================================ -->

    <route id="route_parkway_we"  edges="parkway_gw_w parkway_w_c parkway_c_e parkway_e_ge"/>
    <route id="route_parkway_ew"  edges="parkway_ge_e parkway_e_c parkway_c_w parkway_w_gw"/>
    <route id="route_avenue_ns"   edges="avenue_gn_n avenue_n_c avenue_c_s avenue_s_gs"/>
    <route id="route_avenue_sn"   edges="avenue_gs_s avenue_s_c avenue_c_n avenue_n_gn"/>
    <route id="route_beltway_cw"  edges="parkway_w_c parkway_c_e eastway_e_ne ring_ne_n ring_n_nw westway_nw_w westway_w_sw bypass_sw_s bypass_s_se eastway_se_e"/>
    <route id="route_beltway_ccw" edges="parkway_e_c parkway_c_w westway_w_nw ring_nw_n ring_n_ne eastway_ne_e eastway_e_se bypass_se_s bypass_s_sw westway_sw_w"/>
    <route id="route_loop_nw"     edges="parkway_w_c avenue_c_n ring_n_nw westway_nw_w parkway_w_c"/>
    <route id="route_loop_ne"     edges="parkway_c_e eastway_e_ne ring_ne_n avenue_n_c parkway_c_e"/>
    <route id="route_loop_sw"     edges="parkway_c_w westway_w_sw bypass_sw_s avenue_s_c parkway_c_w"/>
    <route id="route_loop_se"     edges="parkway_c_e eastway_e_se bypass_se_s avenue_s_c parkway_c_e"/>

    <!-- ================================================================ -->
    <!--  CONTINUOUS FLOWS (Strictly sorted chronologically by begin)     -->
    <!-- ================================================================ -->

    <flow id="flow_01_parkway_we"  type="car_connected" route="route_parkway_we"  begin="0.0" end="3600.0" period="7.0"  departLane="0" departSpeed="12.0"/>
