<viewsettings>
    <scheme name="real world">
        <opengl
            dither="1"
            antialiasing="1"
        />
        <background
            backgroundColor="240,238,230,255"
            showGrid="0"
        />
        <edges
            laneEdgeMode="0"
            laneShowBorders="1"
            showLinkDecals="1"
            showRails="0"
            edgeName_show="1"
            edgeName_size="40"
            edgeName_color="80,80,80,180"
            laneName_show="0"
        />
        <vehicles
            vehicleMode="0"
            vehicleQuality="2"
            vehicle_minSize="3.0"
            vehicle_exaggeration="1.2"
            vehicleName_show="0"
        />
        <junctions
            drawLinkTLIndex="1"
            drawLinkJunctionIndex="0"
            junctionName_show="1"
            junctionName_size="50"
            junctionName_color="100,50,50,220"
        />
        <pois
            poiSize_exaggeration="3.0"
            poiName_show="1"
            poiName_size="60"
        />
        <polygons
            polyName_show="0"
        />
    </scheme>
    <viewport
        zoom="120"
        x="600"
        y="500"
    />
</viewsettings>
