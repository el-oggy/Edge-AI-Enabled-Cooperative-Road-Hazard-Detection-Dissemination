<?xml version='1.0' encoding='utf-8'?>
<configuration>
  <input>
    <net-file value="loop.net.xml" />
    <route-files value="loop.rou.xml" />
    <additional-files value="loop.scenery.add.xml" />
    <gui-settings-file value="loop.view.xml" />
  </input>
  <time>
    <begin value="0" />
    <end value="3600" />
    <step-length value="0.1" />
  </time>
  <processing>
    <collision.action value="warn" />
  </processing>
  <gui_only>
    <start value="true" />
    <quit-on-end value="true" />
  </gui_only>
</configuration>