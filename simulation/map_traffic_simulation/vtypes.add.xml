<additional>
    <!-- Indian Mixed Traffic Vehicle Types -->
    
    <!-- Bike/Motorcycle: Smallest and most frequent. Blue color. -->
    <vType id="bike" vClass="motorcycle" length="2.0" width="0.8" color="0,0,255" accel="2.5" decel="4.5" maxSpeed="20.0" />
    
    <!-- Auto Rickshaw: Smaller than a car, slightly slower. Yellow color. -->
    <vType id="auto" vClass="passenger" length="3.2" width="1.4" color="255,255,0" accel="1.5" decel="3.5" maxSpeed="15.0" />
    
    <!-- Standard Car: Average passenger vehicle. Red color. -->
    <vType id="car" vClass="passenger" length="4.5" width="1.8" color="255,0,0" accel="2.0" decel="4.5" maxSpeed="25.0" />
    
    <!-- Bus: Long vehicle, slower acceleration. Green color. -->
    <vType id="bus" vClass="bus" length="11.0" width="2.5" color="0,255,0" accel="1.0" decel="3.0" maxSpeed="18.0" />
    
    <!-- Truck: Heavy vehicle, lowest acceleration. Orange color. -->
    <vType id="truck" vClass="truck" length="8.0" width="2.5" color="255,165,0" accel="1.0" decel="3.0" maxSpeed="18.0" />

    <!-- Our EGO Vehicle:
         - White color for easy tracking
         - sigma=0 means it behaves deterministically (no driver imperfection)
         - higher deceleration for emergency braking if needed
         - has.ssm.device="true" enables the Surrogate Safety Management (SSM) device to log Time-To-Collision (TTC)
    -->
    <vType id="ego_type" vClass="passenger" length="4.5" width="1.8" color="255,255,255" accel="2.5" decel="5.5" maxSpeed="25.0" sigma="0">
        <param key="has.ssm.device" value="true"/>
    </vType>
</additional>
