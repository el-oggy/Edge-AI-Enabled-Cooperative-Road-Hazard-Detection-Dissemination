<?xml version="1.0" encoding="UTF-8"?>
<routes xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="http://sumo.dlr.de/xsd/routes_file.xsd">
    <!-- Vehicle Types -->
    <vType id="car" vClass="passenger" accel="2.6" decel="4.5" length="4.5" maxSpeed="11.11" color="0,180,255" sigma="0.5"/>
    <vType id="bus" vClass="bus" accel="1.2" decel="3.5" length="12.0" maxSpeed="9.0" color="255,190,0" sigma="0.3"/>
    <vType id="truck" vClass="truck" accel="1.5" decel="3.5" length="8.0" maxSpeed="10.0" color="255,100,50" sigma="0.4"/>
    <vType id="motorcycle" vClass="motorcycle" accel="3.5" decel="5.0" length="2.2" maxSpeed="11.11" color="50,255,150" sigma="0.6"/>

    <!-- Circulation Routes with U-turns -->
    <route id="route_NS" edges="N2J0 J02S S2J0 J02N N2J0 J02S S2J0 J02N"/>
    <route id="route_SN" edges="S2J0 J02N N2J0 J02S S2J0 J02N N2J0 J02S"/>
    <route id="route_WE" edges="W2J0 J02E E2J0 J02W W2J0 J02E E2J0 J02W"/>
    <route id="route_EW" edges="E2J0 J02W W2J0 J02E E2J0 J02W W2J0 J02E"/>
    <route id="route_NE" edges="N2J0 J02E E2J0 J02W W2J0 J02N N2J0 J02E"/>
    <route id="route_SW" edges="S2J0 J02W W2J0 J02E E2J0 J02S S2J0 J02W"/>

    <!-- Vehicle Flows sorted strictly by departure time -->
    <flow id="flow_car_ns" type="car" route="route_NS" begin="0" end="1800" period="10" departLane="best" departSpeed="max"/>
    <flow id="flow_car_sn" type="car" route="route_SN" begin="2" end="1800" period="10" departLane="best" departSpeed="max"/>
    <flow id="flow_car_we" type="car" route="route_WE" begin="4" end="1800" period="10" departLane="best" departSpeed="max"/>
    <flow id="flow_bus_ns" type="bus" route="route_NS" begin="5" end="1800" period="40" departLane="0" departSpeed="8"/>
    <flow id="flow_car_ew" type="car" route="route_EW" begin="6" end="1800" period="10" departLane="best" departSpeed="max"/>
    <flow id="flow_car_ne" type="car" route="route_NE" begin="7" end="1800" period="15" departLane="best" departSpeed="max"/>
    <flow id="flow_moto_sn" type="motorcycle" route="route_SN" begin="8" end="1800" period="18" departLane="best" departSpeed="max"/>
    <flow id="flow_truck_we" type="truck" route="route_WE" begin="10" end="1800" period="35" departLane="0" departSpeed="8"/>
    <flow id="flow_car_sw" type="car" route="route_SW" begin="11" end="1800" period="15" departLane="best" departSpeed="max"/>
    <flow id="flow_moto_ew" type="motorcycle" route="route_EW" begin="15" end="1800" period="18" departLane="best" departSpeed="max"/>
</routes>
