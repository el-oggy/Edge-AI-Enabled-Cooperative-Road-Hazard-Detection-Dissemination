<?xml version="1.0" encoding="UTF-8"?>
<configuration>
  <input>
    <net-file value="foundry.net.xml"/>
    <route-files value="foundry.rou.xml"/>
    <additional-files value="foundry.scenery.add.xml"/>
    <gui-settings-file value="foundry.view.xml"/>
